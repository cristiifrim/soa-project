{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "UserName": "guest",
    "Password": "guest"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9093"
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "ads-route": {
        "ClusterId": "ads-cluster",
        "Match": {
          "Path": "/ads/{**catch-all}"
        }
      },
      "chat-route": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/chat/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://user-service:3001"
          }
        }
      },
      "ads-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://ads-service:3002"
          }
        }
      },
      "chat-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://chat-service:3003"
          }
        }
      }
    }
  },
  "Urls": "http://0.0.0.0:3000"
}
